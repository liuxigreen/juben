    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother sets the cup down on the counter",
    "spoken_dialogue": "有些味道，不是用舌头记住的",
    "dialogue_speaker": "grandmother",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "sticky note",
    "emotion": "Neutral",
    "source_text": "她放下杯子，走到墙边。外婆的便签——\"有些味道，不是用舌头记住的\"——还在。字迹没淡。"
  },
  {
    "beat_id": 11,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian reaches out to touch gently",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "sticky note",
    "emotion": "Warmth",
    "source_text": "她伸手摸了摸便签。纸面温暖的——不是因为阳光，是因为这张便签贴在暖气管旁边，被管子的温度捂热了。"
  },
  {
    "beat_id": 12,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念把脸贴在墙上。墙壁冰凉的，但暖气管旁边的那一小块是温的。"
  },
