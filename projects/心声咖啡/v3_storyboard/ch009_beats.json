  {
    "beat_id": 26,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian sets the cup down on the counter",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "sticky note",
    "emotion": "Neutral",
    "source_text": "苏念放下杯子。茶水溅出来，淌在吧台上，浸湿了一张便签纸。\n她低头看自己的左手手背。"
  },
  {
    "beat_id": 27,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "scar on skin",
    "emotion": "Neutral",
    "source_text": "一道浅浅的疤痕——她记得是小时候被外婆的猫抓的。\n还在。"
  },
  {
    "beat_id": 28,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian furrows brow, pressing fingers to temples",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Shock",
    "source_text": "但她突然想不起来，那只猫叫什么名字了。"
  },
  {
    "beat_id": 29,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "the phone buzzes on the counter",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "手机震了一下。"
  },
  {
    "beat_id": 30,
    "space": "Physical",
    "characters_present": [
      "Gu Shen"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "a message notification on screen",
    "spoken_dialogue": "到家了。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深的消息：\"到家了。\""
  },
  {
    "beat_id": 31,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian carries a steaming cup",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Mystery",
    "source_text": "苏念看着那三个字。她的手指悬在屏幕上方，还没来得及打字——\n吧台上的灯闪了一下。\n她抬头。灯管嗡嗡响着，光忽明忽暗。然后灭了。\n咖啡店陷入黑暗。\n苏念站在吧台后"
  },
  {
    "beat_id": 32,
    "space": "Physical",
    "characters_present": [
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "the handwriting on the sticky note fades by one stroke",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "sticky note",
    "emotion": "Mystery",
    "source_text": "吧台上，那张被茶水浸湿的便签纸——外婆写的那张——字迹淡了一个笔画。"
  },
  {
    "beat_id": 33,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stares intently",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "sticky note",
    "emotion": "Neutral",
    "source_text": "苏念盯着那个笔画。她确定，刚才那张便签上，\"念\"字的最后一笔还在。"
  },
  {
    "beat_id": 34,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "现在没了。"
  }
]