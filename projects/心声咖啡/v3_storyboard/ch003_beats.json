    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深喝了半杯，起身去接电话。杯子留在吧台上，咖啡还冒着热气。"
  },
