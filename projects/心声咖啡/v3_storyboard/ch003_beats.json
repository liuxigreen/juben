    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Sadness",
    "source_text": "顾深回来了。他看着苏念脸上的泪痕，皱了皱眉。"
  },
  {
    "beat_id": 10,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian wipes tears from eyes",
    "spoken_dialogue": "没事。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Sadness",
    "source_text": "\"没事。\"苏念擦掉眼泪，\"咖啡凉了，我给你换一杯。\""
  },
  {
    "beat_id": 11,
    "space": "Physical",
    "characters_present": [
