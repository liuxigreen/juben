    "primary_char": "Su Nian",
    "action_visual": "Su Nian speaks softly the coffee cup",
    "spoken_dialogue": "你记得我喝什么？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深第三天来的时候，苏念已经把他的美式准备好了。\n\"你记得我喝什么？\"他有些意外。\n\"常客。\"苏念说。她在撒谎。她只是读了他的心——虽然还没喝那杯咖啡。"
  },
  {
    "beat_id": 2,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "但她想再试一次。"
  },
  {
    "beat_id": 3,
    "space": "Physical",
    "characters_present": [
      "Gu Shen"
    ],
    "primary_char": "Gu Shen",
