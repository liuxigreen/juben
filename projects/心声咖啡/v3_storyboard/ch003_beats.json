    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen carries a steaming cup",
    "spoken_dialogue": "不用。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"不用。\"顾深端起杯子，把剩下的半杯一饮而尽，\"凉的也行。\""
  },
  {
