    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "watercolor painting",
    "emotion": "Neutral",
    "source_text": "顾深喝完了，起身要走。杯子留在桌上，咖啡渣在杯底画着漩涡。"
  },
