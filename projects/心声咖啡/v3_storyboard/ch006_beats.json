[
  {
    "beat_id": 1,
    "space": "Physical",
    "characters_present": [
      "Gu Shen"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深第六天来的时候，外面在下雨。"
  },
  {
    "beat_id": 2,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen places down the door",
    "spoken_dialogue": "美式。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他把湿伞放在门口，西装肩膀上有深色的水渍。这次他没坐吧台，而是选了靠窗的位子。\n\"美式。\""
  },
  {
    "beat_id": 3,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian carries a steaming cup",
    "spoken_dialogue": "你每天都来。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念端过去。他接过杯子，没喝，只是握着。\n\"你每天都来。\"苏念说。"
  },
  {
    "beat_id": 4,
    "space": "Physical",
    "characters_present": [
      "Gu Shen"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen gazes at the coffee cup",
    "spoken_dialogue": "你的咖啡比楼下的好。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"你的咖啡比楼下的好。\"顾深看着窗外的雨，\"而且……安静。\""
  },
  {
    "beat_id": 5,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian turns around",
    "spoken_dialogue": "等一下。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念转身要走。\n\"等一下。\"顾深叫住她，\"上次你说不考虑合作。我想知道为什么。\""
  },
  {
    "beat_id": 6,
    "space": "Physical",
    "characters_present": [
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "因为这是外婆留给我的。",
    "dialogue_speaker": "grandmother",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"因为这是外婆留给我的。\"\n\"你外婆——\"\n\"去世了。\""
  },
  {
