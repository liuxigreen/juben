    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念放下杯子。"
  },
  {
    "beat_id": 18,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian looks down",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "back of hand",
    "emotion": "Mystery",
    "source_text": "代价——她低头看手。左手手背上，一道她记得是小时候被猫抓的痕迹，消失了。皮肤光滑得像从未被抓过。"
  },
  {
