[
  {
    "beat_id": 1,
    "space": "Physical",
    "characters_present": [
      "Chen Rui"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui gazes at, motionless",
    "spoken_dialogue": "苏老板，这是我们的评估团队。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "陈锐第二次来，带了两个人。一男一女，西装革革，拿着平板电脑。\n\"苏老板，这是我们的评估团队。\"陈锐说，\"他们需要看一下你的——\"\n\"不看。\""
  },
  {
    "beat_id": 2,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Chen Rui"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian carries a steaming cup",
    "spoken_dialogue": "公司给了最后期限。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "陈锐叹了口气。他示意两人去旁边坐着，自己坐到吧台前。\n苏念做好一杯意式浓缩端过去。陈锐喝了一口，放下。杯子在吧台上发出一声轻响。\n他从公文包里抽出一份文件，推到"
  },
  {
    "beat_id": 3,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Chen Rui"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian gazes at, motionless",
    "spoken_dialogue": "你这栋楼的产权——",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念没看文件。她看着陈锐的手——他的右手食指在纸面上敲了两下，指甲修得很短。\n\"你这栋楼的产权——\"陈锐的语速比平时快了一点，\"你外婆是从开发商手里买的，但开发"
  },
  {
    "beat_id": 4,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian clenches fists tightly",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "cup wall",
    "emotion": "Neutral",
    "source_text": "苏念的手握紧了杯子。杯壁上的水珠被她的掌心温度蒸发了。\n他的杯子还在冒热气。"
  },
  {
    "beat_id": 5,
    "space": "Transition",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian lifts the cup, fingers trembling around the warm rim",
