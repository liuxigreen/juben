  {
    "beat_id": 21,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian picks up the rag",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "watercolor painting",
    "emotion": "Neutral",
    "source_text": "苏念从吧台下面拿出一块抹布，擦了擦他面前的水渍。她的动作很慢，手指在木质台面上画了一个圈。"
  },
  {
    "beat_id": 22,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian bends down",
    "spoken_dialogue": "陈总。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"陈总。\"苏念弯腰，嘴唇几乎贴着他的耳朵，\"三年前那栋楼的产权问题，解决了。你们公司知道。\""
  },
  {
    "beat_id": 23,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui looks up",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "陈锐的手指停在文件上。纸被他的指甲掐出一个小缺口。\n他没抬头。沉默了五秒。"
  },
  {
    "beat_id": 24,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands up from the seat",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "然后他站起来，对旁边的两个人使了个眼色。两人收起平板电脑，先走了。\n陈锐站在吧台前，盯着苏念看了五秒。他的下颌肌肉在动——在磨牙。\n苏念把抹布叠好，放回吧台下面"
  },
  {
    "beat_id": 25,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui turns around",
    "spoken_dialogue": "下周五之前。不管你知道什么。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "陈锐深吸一口气，转身走了。走到门口时他停了一下，头也不回地说：\n\"下周五之前。不管你知道什么。\""
  },
  {
    "beat_id": 26,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "the wind chimes ring softly",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "门关上了。门框上的风铃晃了两下，发出清脆的叮当声。\n苏念独自站在吧台后面。"
  },
  {
    "beat_id": 27,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother looks down",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "scar on skin",
    "emotion": "Neutral",
    "source_text": "她低头看左手手背。那道猫抓的疤痕——五岁时被外婆养的橘猫抓的，外婆一边给她贴创可贴一边骂猫——"
  },
  {
    "beat_id": 28,
    "space": "Physical",
    "characters_present": [
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "没了。\n外婆的猫叫什么名字？"
  },
  {
    "beat_id": 29,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian turns hand over to inspect",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "handwriting",
    "emotion": "Mystery",
    "source_text": "她翻出手机相册，找到一张老照片。照片里有一只橘猫，蹲在咖啡店门口的台阶上。照片背面有外婆的字迹，写着一个名字——\n但那个名字的最后一个字，像是被水泡过，模糊得看"
  },
  {
    "beat_id": 30,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian gazes at the phone",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "手机屏幕闪了一下。"
  },
  {
    "beat_id": 31,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian writes the photo",
    "spoken_dialogue": "文件不存在",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "old photo",
    "emotion": "Mystery",
    "source_text": "照片消失了。相册里只剩下一个灰色的占位符，上面写着\"文件不存在\"。"
  },
  {
    "beat_id": 32,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian trembles visibly",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Tension",
    "source_text": "苏念的手在发抖。她退出相册，又点进去。\n还是灰色。"
  },
  {
    "beat_id": 33,
    "space": "Physical",
    "characters_present": [
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother writes the photo",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "old photo",
    "emotion": "Neutral",
    "source_text": "那张照片，连同外婆写的那个名字，一起没了。"
  }
]