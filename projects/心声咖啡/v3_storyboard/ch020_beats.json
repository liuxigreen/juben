    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念的嘴角弯起来——很小的一下，像拉花失败了，歪歪扭扭的，但很好看。"
  },
  {
    "beat_id": 28,
    "space": "Physical",
    "characters_present": [
