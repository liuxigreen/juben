    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "cup wall",
    "emotion": "Neutral",
    "source_text": "顾深喝了一口咖啡。他的手指在杯壁上画了一个圈。"
  },
  {
    "beat_id": 26,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen speaks softly",
    "spoken_dialogue": "我明天还来。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"我明天还来。\"他说。\n\"嗯。\"\n\"后天也来。\"\n\"嗯。\"\n\"每天都来。\""
  },
  {
    "beat_id": 27,
    "space": "Physical",
    "characters_present": [
