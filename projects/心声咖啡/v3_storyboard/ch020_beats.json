    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"好。\"她说。"
  },
  {
    "beat_id": 29,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands up from the seat",
    "spoken_dialogue": "苏念。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深站起来，把钱放在吧台上。他走到门口，停下来。\n\"苏念。\"\n\"嗯。\""
  },
  {
    "beat_id": 30,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen speaks softly",
    "spoken_dialogue": "你笑的样子——",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"你笑的样子——\"他说，\"和我第一次来的时候一样。\""
  },
  {
    "beat_id": 31,
    "space": "Physical",
    "characters_present": [
