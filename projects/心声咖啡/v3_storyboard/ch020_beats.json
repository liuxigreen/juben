    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen wipes the counter with a rag",
    "spoken_dialogue": "你今天没喝。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "她转身，去擦吧台。吧台已经很干净了，但她的手需要做点什么。\n\"你今天没喝。\"顾深说。"
  },
  {
    "beat_id": 15,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian speaks softly",
    "spoken_dialogue": "为什么？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"嗯。\"苏念说。\n\"为什么？\""
  },
  {
    "beat_id": 16,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian hand pauses mid-motion",
    "spoken_dialogue": "因为——",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "scar on skin",
    "emotion": "Neutral",
    "source_text": "苏念的手停在吧台上。她看着自己的左手手背——光滑的，什么都没有。疤痕、痣、印记，全没了。\n\"因为——\"她说，\"我怕再忘掉什么。\""
  },
  {
    "beat_id": 17,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen sets the cup down on the counter",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深放下杯子。他的灰色眼睛在晨光里变成了琥珀色。"
  },
  {
    "beat_id": 18,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen speaks softly",
    "spoken_dialogue": "你已经忘了很多。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"你已经忘了很多。\"他说。这不是问句。"
  },
  {
    "beat_id": 19,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian furrows brow, pressing fingers to temples",
    "spoken_dialogue": "我不记得我爸妈。不记得我外婆的声音。不记得我哥哥。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"嗯。\"苏念说。\"我不记得我爸妈。不记得我外婆的声音。不记得我哥哥。\""
  },
  {
    "beat_id": 20,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian gazes at the coffee cup",
    "spoken_dialogue": "但我记得怎么冲咖啡。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "她停了一下。\n\"但我记得怎么冲咖啡。\""
  },
  {
    "beat_id": 21,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen gazes at",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "顾深看着她。他的表情像是在做一道数学题——每一步都精确，但答案怎么都凑不齐。"
  },
  {
    "beat_id": 22,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "那够吗？",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"那够吗？\"他问。"
  },
  {
    "beat_id": 23,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念想了想。"
  },
  {
    "beat_id": 24,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian speaks softly the coffee cup",
    "spoken_dialogue": "因为咖啡不在脑子里。在手里。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"够。\"她说。\"因为咖啡不在脑子里。在手里。\""
  },
  {
    "beat_id": 25,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
