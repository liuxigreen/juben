    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "business card",
    "emotion": "Neutral",
    "source_text": "苏念抬头。男人站在吧台前，手里拿着一张名片。"
  },
  {
    "beat_id": 16,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen writes the card",
    "spoken_dialogue": "我叫顾深。对面写字楼的。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "business card",
    "emotion": "Neutral",
    "source_text": "\"我叫顾深。对面写字楼的。\"他把名片推过来，\"我想问一下——你们店有没有考虑过……合作？\""
  },
  {
    "beat_id": 17,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian takes the envelope",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "business card",
    "emotion": "Neutral",
    "source_text": "苏念接过名片。烫金的字：顾深，合伙人，锐见投资。\n她看着他的眼睛。灰色的，像阴天的天空。"
  },
  {
    "beat_id": 18,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian speaks softly",
    "spoken_dialogue": "不考虑。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"不考虑。\"她说。"
  },
  {
    "beat_id": 19,
    "space": "Physical",
    "characters_present": [
      "Gu Shen"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen smiles faintly",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Warmth",
    "source_text": "顾深愣了一下，然后笑了——很浅，嘴角只动了一毫米。"
  },
