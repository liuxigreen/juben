    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian speaks softly the coffee cup",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "……前女友说我不懂感情。也许她说得对。但我也不懂为什么隔壁那家破咖啡店的咖啡比星巴克好喝……不对，我在想什么，我是来谈收购的……",
    "voice_type": "inner_voice",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "世界安静了。\n*\"……前女友说我不懂感情。也许她说得对。但我也不懂为什么隔壁那家破咖啡店的咖啡比星巴克好喝……不对，我在想什么，我是来谈收购的……\"*"
  },
  {
    "beat_id": 7,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
