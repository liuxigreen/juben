    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念回到吧台后面。十分钟后，男孩红着脸在女孩面前跪下来，从口袋里掏出一张皱巴巴的电影票——两张，下周二，女孩生日那天。"
  },
