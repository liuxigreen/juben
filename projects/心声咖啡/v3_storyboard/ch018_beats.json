[
  {
    "beat_id": 1,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui sits down",
    "spoken_dialogue": "意式浓缩。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "陈锐来的时候没带人。\n他一个人，穿着一件深蓝色的polo衫，手腕上的表还是那块——但表带换过了，从金属换成了皮的。\n他坐到吧台前，把一个牛皮纸信封放在台面上。\n"
  },
  {
    "beat_id": 2,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian carries a steaming cup",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念做好端过去。陈锐喝了一口，放下。杯子在台面上发出一声轻响。\n他把信封推到苏念面前。"
  },
  {
    "beat_id": 3,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "什么？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"什么？\"苏念问。"
  },
  {
    "beat_id": 4,
    "space": "Physical",
    "characters_present": [
      "Chen Rui"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui puts away",
    "spoken_dialogue": "收购终止协议。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"收购终止协议。\"陈锐的声音很平。\"公司批了。你的店不用卖了。\""
  },
  {
    "beat_id": 5,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian gazes at the letter",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念没碰信封。她看着陈锐的脸——他的下颌线条比上次松弛了一点，没有在磨牙。"
  },
  {
    "beat_id": 6,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "为什么？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"为什么？\"苏念问。"
  },
  {
    "beat_id": 7,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui takes a slow sip",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "cup wall",
    "emotion": "Neutral",
    "source_text": "陈锐喝了一口咖啡。他的手指在杯壁上画了一个圈，像是在做一个决定。"
  },
  {
    "beat_id": 8,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "你知道我以前是做什么的吗？",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"你知道我以前是做什么的吗？\"他问。"
  },
  {
    "beat_id": 9,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian shakes head",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念摇头。"
  },
  {
    "beat_id": 10,
    "space": "Physical",
    "characters_present": [
      "Chen Rui"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui picks up the coffee cup",
    "spoken_dialogue": "锐咖啡",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "old photo",
    "emotion": "Neutral",
    "source_text": "陈锐从口袋里拿出手机，翻到一张照片。照片里是一家很小的咖啡店——比念想还小，只有四张桌子。招牌上写着两个字：\"锐咖啡\"。\n\"这是我开的。\"陈锐说。\"十年前。在城"
  },
  {
    "beat_id": 11,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian gazes at the photo",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "old photo",
    "emotion": "Neutral",
    "source_text": "苏念看着那张照片。店门口有一棵桂花树，树下放着一张折叠椅。"
  },
  {
    "beat_id": 12,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "生意好吗？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"生意好吗？\"苏念问。"
  },
  {
    "beat_id": 13,
    "space": "Physical",
    "characters_present": [
      "Chen Rui"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui speaks softly",
    "spoken_dialogue": "不好。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"不好。\"陈锐说。\"亏了两年。第三年，有人来收购。出价很高。我——\""
  },
  {
    "beat_id": 14,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui hand pauses mid-motion",
    "spoken_dialogue": "这是我老婆。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "old photo",
    "emotion": "Neutral",
    "source_text": "他停了。他的手指在手机屏幕上停了一下，照片放大了——门口的折叠椅上，坐着一个年轻女人。\n\"这是我老婆。\"陈锐说。\"当时还是女朋友。她在这张椅子上等我关店，等到睡"
  },
  {
    "beat_id": 15,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "Chen Rui",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian leans against",
    "spoken_dialogue": "我卖了。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念看着那个女人。她侧着头，靠在椅背上，眼睛闭着。阳光从桂花树的缝隙里漏下来，落在她的脸上。\n\"我卖了。\"陈锐说。\"第三年年底，我卖了。用那笔钱，我买了房子，结"
  },
  {
    "beat_id": 16,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen gazes at the phone",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他的声音没有起伏，但他的手指在手机边缘掐出了痕迹。"
  },
  {
    "beat_id": 17,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "后来呢？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"后来呢？\"苏念问。"
  },
  {
    "beat_id": 18,
    "space": "Physical",
    "characters_present": [
      "Chen Rui"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui sits quietly the coffee cup",
    "spoken_dialogue": "后来——",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "contract",
    "emotion": "Neutral",
    "source_text": "\"后来——\"陈锐把手机收起来，\"公司让我去收购别人的小店。一家一家收。我收了十几家。每次签完合同，我都会去那家店坐一会儿，喝最后一杯咖啡。\""
  },
  {
    "beat_id": 19,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen takes a slow sip",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他喝了一口意式浓缩。"
  },
  {
    "beat_id": 20,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen trembles visibly",
    "spoken_dialogue": "然后我发现——",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Tension",
    "source_text": "\"然后我发现——\"他的声音在发抖，\"每收一家店，我就忘掉一点自己开'锐咖啡'时的感觉。忘掉桂花树下的味道。忘掉老婆在折叠椅上等我的样子。忘掉——\""
  },
  {
    "beat_id": 21,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui speaks softly the coffee cup",
    "spoken_dialogue": "忘掉什么？",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他停了。\n\"忘掉什么？\"\n\"忘掉我为什么喜欢咖啡。\"陈锐说。"
  },
  {
    "beat_id": 22,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Chen Rui"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian eyes widen, body stiffens, breath catches",
    "spoken_dialogue": "所以你来收购我的店——",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念的指甲在吧台上敲了一下。\n\"所以你来收购我的店——\"\n\"是因为我必须完成公司的任务。\"陈锐说。\"但每次来你这里，我都会想起来——我以前也是这样的人。守着一家"
  },
  {
    "beat_id": 23,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen speaks softly the letter",
    "spoken_dialogue": "签了吧。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他把信封又推了一下。\n\"签了吧。\"他说。\"公司不会再来了。我跟他们说了——这条巷子不适合开发。结构不达标，拆迁成本太高。\""
  },
  {
    "beat_id": 24,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Chen Rui"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian gazes at the letter",
    "spoken_dialogue": "你跟公司撒了谎。",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念看着那个信封。\n\"你跟公司撒了谎。\"\n\"我跟公司说了实话。\"陈锐说。\"这条巷子的楼确实结构不达标。但不达标的原因是——开发商当年偷工减料。我查过了。那个开发"
  },
  {
    "beat_id": 25,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui speaks softly",
    "spoken_dialogue": "是谁？",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他停了。\n\"是谁？\"\n\"是我现在这家公司的母公司。\"陈锐说。\"二十年前的事了。他们当年偷工减料，现在又来收购拆迁——就是为了销毁证据。\""
  },
  {
    "beat_id": 26,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian clenches fists tightly",
    "spoken_dialogue": "你知道这些——你还帮他们收购？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Tension",
    "source_text": "苏念的手攥紧了杯子。\n\"你知道这些——你还帮他们收购？\"\n\"我以前不知道。\"陈锐说。\"是最近才查到的。所以我辞职了。\""
  },
  {
    "beat_id": 27,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian speaks softly",
    "spoken_dialogue": "你也辞职了？",
    "dialogue_speaker": "Su Nian",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念的呼吸停了。\n\"你也辞职了？\"\n\"昨天递的辞呈。\"陈锐说。他的声音恢复了平时的平静，但他的眼睛里有一种苏念没见过的表情——像是卸下了一副很重的担子。"
  },
  {
    "beat_id": 28,
    "space": "Physical",
    "characters_present": [
      "Gu Shen"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen stands still, shoulders slightly tense, eyes unfocused",
    "spoken_dialogue": "你和顾深——同一天辞职？",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"你和顾深——同一天辞职？\""
  },
  {
    "beat_id": 29,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui speaks softly",
    "spoken_dialogue": "巧合。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "\"巧合。\"陈锐说。他的嘴角动了一下——不是笑，是苦笑。\"不过，也许不是巧合。\""
  },
  {
    "beat_id": 30,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen stands up from the seat",
    "spoken_dialogue": "不用找了。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他站起来，从口袋里掏出钱包，抽出一张二十块钱，放在吧台上。\n\"不用找了。\""
  },
  {
    "beat_id": 31,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui trembles visibly",
    "spoken_dialogue": "苏老板。",
    "dialogue_speaker": "Chen Rui",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Tension",
    "source_text": "他走到门口，停下来。\n\"苏老板。\"\n\"嗯。\"\n\"你外婆的咖啡——是我喝过最好的。\"陈锐的声音在发抖。\"比我自己做的好。\""
  },
  {
    "beat_id": 32,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian turns and leaves",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "苏老板，对不起。——陈锐",
    "voice_type": "inner_voice",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "他走了。门关上。风铃晃了两下——风铃修好了，声音比以前清脆了一点。\n苏念站在吧台后面。她看着那个牛皮纸信封，手指在信封边缘停了三秒。\n她拆开信封。里面是一份文件"
  },
  {
    "beat_id": 33,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian places down",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念把文件折好，放进吧台的抽屉里。"
  },
  {
    "beat_id": 34,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "grandmother"
    ],
    "primary_char": "grandmother",
    "action_visual": "grandmother reaches out to touch gently",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "sticky note",
    "emotion": "Mystery",
    "source_text": "她走到墙边，看着外婆的便签。便签上的字又淡了一个笔画。\n她伸手摸了摸便签。纸面冰凉。"
  },
  {
    "beat_id": 35,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Lin Ke",
      "Chen Rui",
      "grandmother"
    ],
    "primary_char": "Chen Rui",
    "action_visual": "Chen Rui sees something",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "念想咖啡，值得留下来。",
    "voice_type": "inner_voice",
