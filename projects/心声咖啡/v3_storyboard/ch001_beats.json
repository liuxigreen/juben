[
  {
    "beat_id": 1,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian wipes the counter with a rag",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念用抹布擦着吧台，第三次看向门口。\n下午三点，\"念想\"咖啡店只有两桌客人。靠窗的老大爷在打瞌睡，角落的女孩对着笔记本电脑皱眉。营业额今天又是赤字。"
  },
  {
    "beat_id": 2,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "the doorbell chimes",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "门铃响了。"
  },
  {
    "beat_id": 3,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen walks through the door",
    "spoken_dialogue": "美式，热的。",
    "dialogue_speaker": "Gu Shen",
    "inner_voice": "",
    "voice_type": "onscreen",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "一个穿灰色西装的男人走进来，径直坐到吧台前。他没看菜单，掏出手机放桌上，屏幕朝下。\n\"美式，热的。\""
  },
  {
    "beat_id": 4,
    "space": "Physical",
    "characters_present": [
      "Su Nian",
      "Gu Shen",
      "Lin Ke",
      "Chen Rui",
      "Su Yuan",
      "grandmother"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian grinds coffee beans, the grinder humming",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "ink stain",
    "emotion": "Neutral",
    "source_text": "苏念点头，转身磨豆。男人的手指在桌面上敲——食指，中指，无名指，循环。她以前没见过这个人，但他西装袖口有一道细小的墨渍，像是签字时蹭的。对面写字楼的人。"
  },
  {
    "beat_id": 5,
    "space": "Physical",
    "characters_present": [
      "Gu Shen",
      "Chen Rui",
      "Su Yuan"
    ],
    "primary_char": "Gu Shen",
    "action_visual": "Gu Shen carries a steaming cup",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "lipstick mark",
    "emotion": "Neutral",
    "source_text": "咖啡端上去。男人喝了一口，杯子放下时，杯沿留着一圈干净的唇印——他没有涂唇膏，那是杯壁上残留的水汽凝成的弧形。"
  },
  {
    "beat_id": 6,
    "space": "Physical",
    "characters_present": [
      "Su Nian"
    ],
    "primary_char": "Su Nian",
    "action_visual": "Su Nian wipes a table clean",
    "spoken_dialogue": "",
    "dialogue_speaker": "",
    "inner_voice": "",
    "voice_type": "none",
    "focus_object": "",
    "emotion": "Neutral",
    "source_text": "苏念转身去擦第二张桌子。"
  },
  {
    "beat_id": 7,
    "space": "Physical",
    "characters_present": [
